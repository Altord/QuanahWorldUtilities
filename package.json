{
  "name": "quanah-world-utilities",
  "productName": "Quanah World Utilities",
  "version": "0.2.0",
  "description": "3L Set Solver, Jewel Socket Scanner, and Progression Utilities for MapleStory Quanah World",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/parse.test.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.altord.quanahworldutilities",
    "productName": "Quanah World Utilities",
    "asarUnpack": [
      "lib/ocr.ps1"
    ],
    "files": [
      "main.js",
      "preload.js",
      "Quanah World Utilities.htm",
      "lib/**/*",
      "docs/dungeon/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
